{
  "name": "sitecommenter",
  "version": "0.1.0",
  "description": "Screen annotations and UI feedback with screenshots (React module + Chrome extension)",
  "type": "module",
  "license": "MIT",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p extension",
    "build:extension": "node extension/build.mjs",
    "demo": "node demo/build.mjs && node demo/serve.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "react",
    "feedback",
    "annotation",
    "screenshot",
    "chrome-extension",
    "ui"
  ]
}
